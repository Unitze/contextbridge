<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package (identity only). The binaries live in the installation folder and are
  attached with: Add-AppxPackage <msix> -ExternalLocation <installdir> -AllowUnsigned
  The publisher carries the "unsigned" OID so Windows accepts the package without a signature.
  Placeholders (@VERSION@, @ARCH@) are filled in by scripts/build_msix.py.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop desktop4 desktop5 com rescap">

  <Identity
    Name="ContextBridge"
    Publisher="CN=ContextBridge, OID.2.25.311729368913984317654407730594956997722=1"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>ContextBridge</DisplayName>
    <PublisherDisplayName>ContextBridge contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <!-- 22000 = Windows 11 21H2, the first build with the new context menu. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-jp" />
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="ContextBridge"
                 Executable="ContextBridge.exe"
                 uap10:TrustLevel="mediumIL"
                 uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="ContextBridge"
        Description="Add any program to the Windows 11 context menu"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <!-- The schema only accepts "*", ".ext", "Directory" and "Directory\Background"
                 ("Drive" is rejected by MakeAppx). Whether drive roots receive the "Directory" verb
                 still has to be confirmed on Windows 11. -->
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="ContextBridgeFiles" Clsid="E3AC0490-1596-4CD9-8755-45988C3A5DC4" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="ContextBridgeFolders" Clsid="E3AC0490-1596-4CD9-8755-45988C3A5DC4" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="ContextBridgeBackground" Clsid="B668E986-BDA4-4D6B-9511-F4BD8708A764" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="ContextBridge Shell Extension">
              <com:Class Id="E3AC0490-1596-4CD9-8755-45988C3A5DC4" Path="ContextBridge.Shell.dll" ThreadingModel="STA" />
              <com:Class Id="B668E986-BDA4-4D6B-9511-F4BD8708A764" Path="ContextBridge.Shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
