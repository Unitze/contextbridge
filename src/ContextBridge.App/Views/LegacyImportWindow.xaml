<Window x:Class="ContextBridge.App.Views.LegacyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:ContextBridge.App.Resources"
        Title="{x:Static r:Strings.Legacy_WindowTitle}" Width="1060" Height="680" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="OkButton" Content="{x:Static r:Strings.Legacy_Ok}" IsDefault="True" IsEnabled="False" Click="Ok_Click" Style="{StaticResource DialogAccentButton}" />
                    <Button Content="{x:Static r:Strings.Common_Cancel}" IsCancel="True" Style="{StaticResource DialogButton}" />
                </StackPanel>
                <TextBlock x:Name="Summary" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    <DockPanel Margin="24,20,24,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource DialogTitle}" Text="{x:Static r:Strings.Legacy_WindowTitle}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.85" Text="{x:Static r:Strings.Legacy_Intro}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                       Text="{x:Static r:Strings.Legacy_IntroHint}" />
            <DockPanel Margin="0,4,0,10">
                <CheckBox x:Name="ShowUnsupported" Content="{x:Static r:Strings.Legacy_ShowUnsupported}" DockPanel.Dock="Right" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <CheckBox x:Name="ShowImported" Content="{x:Static r:Strings.Legacy_ShowImported}" DockPanel.Dock="Right" Margin="0,0,16,0" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <Button Content="{x:Static r:Strings.Common_SelectAll}" Click="SelectAll_Click" Margin="0,0,6,0" ToolTip="{x:Static r:Strings.Legacy_SelectAllTip}" />
                <Button Content="{x:Static r:Strings.Common_SelectNone}" Click="SelectNone_Click" Margin="0,0,12,0" ToolTip="{x:Static r:Strings.Legacy_SelectNoneTip}" />
                <Grid HorizontalAlignment="Left" MinWidth="260">
                    <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Padding="28,5,8,5" ToolTip="{x:Static r:Strings.Legacy_SearchTip}" AutomationProperties.Name="{x:Static r:Strings.Legacy_SearchTip}" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Opacity="0.55" IsHitTestVisible="False" Margin="9,0,0,0" HorizontalAlignment="Left" />
                </Grid>
            </DockPanel>
        </StackPanel>

        <Expander x:Name="RemovedPanel" DockPanel.Dock="Bottom" Header="{x:Static r:Strings.Legacy_RemovedHeader}" Margin="0,8,0,0">
            <ListBox x:Name="RemovedList" MaxHeight="120">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Remove}">
                            <TextBlock>
                                <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="{x:Static r:Strings.Legacy_RemoveSuffix}" Foreground="Gray" />
                            </TextBlock>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <Grid>
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInclude}"
                                          HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="28">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Icon}" Width="16" Height="16" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static r:Strings.Legacy_ColTitle}" Binding="{Binding Title}" Width="200" IsReadOnly="True" />
                    <DataGridTextColumn Header="{x:Static r:Strings.Legacy_ColStatus}" Binding="{Binding StatusText}" Width="150" IsReadOnly="True" />
                    <DataGridTextColumn Header="{x:Static r:Strings.Legacy_ColTargets}" Binding="{Binding Targets}" Width="150" IsReadOnly="True" />
                    <DataGridTextColumn Header="{x:Static r:Strings.Legacy_ColCommand}" Binding="{Binding Command}" Width="*" IsReadOnly="True" />
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Details}" Margin="40,2,8,6" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
            <TextBlock x:Name="Loading" Text="{x:Static r:Strings.Legacy_Scanning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </DockPanel>
    </DockPanel>
</Window>
