<Window x:Class="ContextBridge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ContextBridge.Core;assembly=ContextBridge.Core"
        xmlns:r="clr-namespace:ContextBridge.App.Resources"
        Title="{Binding WindowTitle}" Width="1180" Height="780" MinWidth="880" MinHeight="560"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseLeftButtonDown="Window_PreviewMouseDown">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAndRestartExplorerCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding MoveUpCommand}" />
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding MoveDownCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="Find_Executed" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                    <Button Command="{Binding ReloadCommand}" Style="{StaticResource ToolButton}" ToolTip="{x:Static r:Strings.Main_ReloadTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                            <TextBlock Text="{x:Static r:Strings.Main_Reload}" />
                        </StackPanel>
                    </Button>
                    <!-- Save + dropdown (save and restart Explorer, restart on every save) -->
                    <Button Command="{Binding SaveCommand}" Margin="0" MinWidth="96" Padding="12,5"
                            Style="{DynamicResource AccentButtonStyle}" ToolTip="{Binding SaveToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" />
                            <TextBlock Text="{x:Static r:Strings.Main_Save}" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" FontSize="11" Margin="6,0,0,0"
                                       Visibility="{Binding RestartExplorerOnSave, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveMenuButton" Click="SaveMenu_Click" Margin="2,0,0,0" Padding="6,5"
                            ToolTip="{x:Static r:Strings.Main_SaveMenuTip}" AutomationProperties.Name="{x:Static r:Strings.Main_SaveMenuTip}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="0" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static r:Strings.Main_SaveAndRestart}" InputGestureText="Ctrl+Shift+S"
                                          Command="{Binding SaveAndRestartExplorerCommand}" />
                                <MenuItem Header="{x:Static r:Strings.Main_RestartOnSave}" IsCheckable="True"
                                          IsChecked="{Binding RestartExplorerOnSave}" />
                                <Separator />
                                <MenuItem Header="{x:Static r:Strings.Main_RestartExplorerNow}" Command="{Binding RestartExplorerCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <WrapPanel Orientation="Horizontal">
                    <Button Command="{Binding AddCommand}" Style="{StaticResource ToolButton}" ToolTip="{x:Static r:Strings.Main_AddTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                            <TextBlock Text="{x:Static r:Strings.Main_Add}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DuplicateCommand}" Style="{StaticResource ToolButton}" ToolTip="{x:Static r:Strings.Main_DuplicateTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" />
                            <TextBlock Text="{x:Static r:Strings.Main_Duplicate}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteCommand}" Style="{StaticResource ToolButton}" ToolTip="{x:Static r:Strings.Main_DeleteTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                            <TextBlock Text="{x:Static r:Strings.Main_Delete}" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Command="{Binding MoveUpCommand}" Style="{StaticResource ToolButton}" ToolTip="{x:Static r:Strings.Main_MoveUpTip}"
                            AutomationProperties.Name="{x:Static r:Strings.Main_MoveUpTip}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" Margin="0" />
                    </Button>
                    <Button Command="{Binding MoveDownCommand}" Style="{StaticResource ToolButton}" ToolTip="{x:Static r:Strings.Main_MoveDownTip}"
                            AutomationProperties.Name="{x:Static r:Strings.Main_MoveDownTip}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" Margin="0" />
                    </Button>
                    <Rectangle Style="{StaticResource ToolSeparator}" />
                    <Button Command="{Binding ImportLegacyCommand}" Style="{StaticResource ToolButton}" ToolTip="{x:Static r:Strings.Main_LegacyTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" />
                            <TextBlock Text="{x:Static r:Strings.Main_Legacy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ImportCommand}" Style="{StaticResource ToolButton}" ToolTip="{x:Static r:Strings.Main_ImportTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" />
                            <TextBlock Text="{x:Static r:Strings.Main_Import}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportCommand}" Style="{StaticResource ToolButton}" ToolTip="{x:Static r:Strings.Main_ExportTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE898;" />
                            <TextBlock Text="{x:Static r:Strings.Main_Export}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Package registration banner -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding PackageNeedsAttention, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{Binding PackageAction}" Command="{Binding RegisterPackageCommand}"
                        Visibility="{Binding HasPackageAction, Converter={StaticResource BoolToVis}}" Padding="12,4" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding PackageMessage}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Opacity="0.6">
                    <Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>

        <!-- Validation issues -->
        <Expander DockPanel.Dock="Bottom" Margin="12,0,12,4" IsExpanded="True">
            <Expander.Style>
                <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Issues.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
            <Expander.Header>
                <TextBlock>
                    <Run Text="{x:Static r:Strings.Main_Issues}" /><Run Text=" (" /><Run Text="{Binding Issues.Count, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
            </Expander.Header>
            <ListBox ItemsSource="{Binding Issues}" MaxHeight="110" BorderThickness="0"
                     SelectionChanged="Issues_SelectionChanged" ToolTip="{x:Static r:Strings.Main_IssuesTip}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:ValidationIssue}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Margin="0,1,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:Severity.Error}">
                                                <Setter Property="Text" Value="&#xEA39;" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <TabControl x:Name="Tabs" Margin="12,8,12,4">
            <!-- ============================== Commands ============================== -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="{x:Static r:Strings.Tab_Commands}" /><Run Text=" (" Foreground="Gray" /><Run Text="{Binding Commands.Count, Mode=OneWay}" Foreground="Gray" /><Run Text=")" Foreground="Gray" />
                    </TextBlock>
                </TabItem.Header>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ListColumn" Width="380" MinWidth="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="380" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="4,6,4,0" Text="{x:Static r:Strings.Cmd_ListHint}" />
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="28,5,28,5"
                                     ToolTip="{x:Static r:Strings.Cmd_SearchTip}" AutomationProperties.Name="{x:Static r:Strings.Cmd_SearchPlaceholder}" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Opacity="0.55" IsHitTestVisible="False" Margin="9,0,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static r:Strings.Cmd_SearchPlaceholder}" Opacity="0.5" IsHitTestVisible="False" Margin="30,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="4,2" Click="ClearSearch_Click"
                                    ToolTip="{x:Static r:Strings.Cmd_ClearSearch}" AutomationProperties.Name="{x:Static r:Strings.Cmd_ClearSearch}"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" Margin="0" />
                            </Button>
                        </Grid>
                        <Grid>
                            <ListView x:Name="CommandList" ItemsSource="{Binding CommandsView}" SelectedItem="{Binding Selected}"
                                      AllowDrop="True" PreviewMouseLeftButtonDown="List_PreviewMouseDown"
                                      PreviewMouseLeftButtonUp="List_PreviewMouseUp"
                                      PreviewMouseMove="List_PreviewMouseMove" Drop="List_Drop" DragOver="List_DragOver">
                                <ListView.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                                </ListView.InputBindings>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static r:Strings.Main_Duplicate}" InputGestureText="Ctrl+D" Command="{Binding DuplicateCommand}" />
                                        <MenuItem Header="{x:Static r:Strings.Cmd_TryRun}" Command="{Binding TryRunCommand}" />
                                        <MenuItem Header="{x:Static r:Strings.Cmd_ExportThis}" Command="{Binding ExportCommand}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static r:Strings.Main_MoveUpTip}" InputGestureText="Alt+↑" Command="{Binding MoveUpCommand}" />
                                        <MenuItem Header="{x:Static r:Strings.Main_MoveDownTip}" InputGestureText="Alt+↓" Command="{Binding MoveDownCommand}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static r:Strings.Main_Delete}" InputGestureText="Delete" Command="{Binding DeleteCommand}" />
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" MinWidth="0"
                                                      ToolTip="{x:Static r:Strings.Cmd_EnabledTip}" AutomationProperties.Name="{x:Static r:Strings.Cmd_EnabledTip}" />
                                            <Image Grid.Column="1" Source="{Binding Icon}" Width="16" Height="16" Margin="4,0,10,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="Opacity" Value="0.45" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Margin="6,0,2,0" VerticalAlignment="Center"
                                                       ToolTip="{Binding IssueText}"
                                                       Visibility="{Binding HasIssue, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                        <Setter Property="Text" Value="&#xE7BA;" />
                                                        <Setter Property="Margin" Value="6,0,2,0" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Text" Value="&#xEA39;" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- No search hits -->
                            <TextBlock Text="{x:Static r:Strings.Cmd_NoMatches}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                       Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVis}}" />

                            <!-- Empty state -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" MaxWidth="320">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Commands.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="32" Opacity="0.5" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="{x:Static r:Strings.Cmd_EmptyTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,4,0,12" Text="{x:Static r:Strings.Cmd_EmptyHint}" />
                                <Button Content="{x:Static r:Strings.Cmd_EmptyAdd}" Command="{Binding AddCommand}" Margin="0,0,0,6" Padding="12,6"
                                        Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                                <Button Content="{x:Static r:Strings.Cmd_EmptyLegacy}" Command="{Binding ImportLegacyCommand}" Margin="0,0,0,6" Padding="12,6" HorizontalAlignment="Stretch" />
                                <Button Content="{x:Static r:Strings.Cmd_EmptyImport}" Command="{Binding ImportCommand}" Padding="12,6" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- Editor -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Commands.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A9;" FontSize="28" Opacity="0.4" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="{x:Static r:Strings.Cmd_SelectPrompt}" Opacity="0.6" />
                    </StackPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="8,0,8,12" DataContext="{Binding Selected}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <!-- Display -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static r:Strings.Cmd_SectionDisplay}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label Content="{x:Static r:Strings.Cmd_Title}" Target="{Binding ElementName=TitleBox}" Style="{StaticResource FieldLabelBox}" />
                                        <TextBox x:Name="TitleBox" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,2,0,6">
                                            <Run Text="{x:Static r:Strings.Cmd_TitleHint}" /><Run Text=" " /><Run Text="{Binding AutoTitleExample, Mode=OneWay}" FontStyle="Italic" />
                                        </TextBlock>
                                        <Label Grid.Row="2" Content="{x:Static r:Strings.Cmd_Group}" Target="{Binding ElementName=GroupBox}" Style="{StaticResource FieldLabelBox}" />
                                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,4" ToolTip="{x:Static r:Strings.Cmd_DeleteGroupTip}"
                                                    AutomationProperties.Name="{x:Static r:Strings.Cmd_DeleteGroupTip}"
                                                    Command="{Binding DataContext.DeleteGroupOfSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Margin="0" />
                                            </Button>
                                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" ToolTip="{x:Static r:Strings.Cmd_NewGroupTip}"
                                                    Command="{Binding DataContext.NewGroupForSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                                                    <TextBlock Text="{x:Static r:Strings.Cmd_NewGroup}" />
                                                </StackPanel>
                                            </Button>
                                            <ComboBox x:Name="GroupBox" ItemsSource="{Binding DataContext.GroupChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding GroupId}" />
                                        </DockPanel>
                                        <Label Grid.Row="3" Content="ID" Style="{StaticResource FieldLabelBox}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Id, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" Opacity="0.7" VerticalAlignment="Center" Margin="0,4" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Conditions -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static r:Strings.Cmd_SectionConditions}" />
                                    <WrapPanel>
                                        <CheckBox Content="{x:Static r:Strings.Target_Files}" IsChecked="{Binding ForFiles}" Margin="0,0,20,4" />
                                        <CheckBox Content="{x:Static r:Strings.Target_Folders}" IsChecked="{Binding ForFolders}" Margin="0,0,20,4" />
                                        <CheckBox Content="{x:Static r:Strings.Target_Background}" IsChecked="{Binding ForBackground}" Margin="0,0,20,4" />
                                        <CheckBox Content="{x:Static r:Strings.Target_Drives}" IsChecked="{Binding ForDrives}" Margin="0,0,20,4" />
                                    </WrapPanel>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label Content="{x:Static r:Strings.Cmd_Extensions}" Target="{Binding ElementName=ExtBox}" Style="{StaticResource FieldLabelBox}" />
                                        <TextBox x:Name="ExtBox" Grid.Column="1" Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="0,2"
                                                 ToolTip="{x:Static r:Strings.Cmd_ExtensionsTip}" IsEnabled="{Binding ForFiles}" />
                                        <Label Grid.Row="1" Content="{x:Static r:Strings.Cmd_SelectionCount}" Target="{Binding ElementName=MinBox}" Style="{StaticResource FieldLabelBox}" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                            <TextBox x:Name="MinBox" Text="{Binding MinSelection, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="64"
                                                     AutomationProperties.Name="{x:Static r:Strings.Cmd_MinSelection}" />
                                            <TextBlock Text="{x:Static r:Strings.Cmd_SelBetween}" VerticalAlignment="Center" Margin="6,0" />
                                            <TextBox Text="{Binding MaxSelection, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="64"
                                                     AutomationProperties.Name="{x:Static r:Strings.Cmd_MaxSelection}" />
                                            <TextBlock Text="{x:Static r:Strings.Cmd_SelSuffix}" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.75" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:Strings.Cmd_ConditionsHint}" />
                                </StackPanel>
                            </Border>

                            <!-- Program -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static r:Strings.Cmd_SectionProgram}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Label Content="{x:Static r:Strings.Cmd_Program}" Target="{Binding ElementName=ProgramBox}" Style="{StaticResource FieldLabelBox}" />
                                        <TextBox x:Name="ProgramBox" Grid.Column="1" Text="{Binding Program, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,2"
                                                 FontFamily="{StaticResource MonoFont}" />
                                        <Button Grid.Column="2" Content="{x:Static r:Strings.Common_Browse}" Margin="6,2,0,2"
                                                Command="{Binding DataContext.BrowseProgramCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ProgramStatus}" ToolTip="{Binding ProgramStatus}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProgramMissing}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Label Grid.Row="2" Content="{x:Static r:Strings.Cmd_Arguments}" Target="{Binding ElementName=ArgumentsBox}" Style="{StaticResource FieldLabelBox}" />
                                        <TextBox x:Name="ArgumentsBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,4" FontFamily="{StaticResource MonoFont}" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6">
                                            <WrapPanel Margin="0,0,0,2">
                                                <TextBlock Text="{x:Static r:Strings.Cmd_Insert}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,6,0" />
                                                <Button Tag="&quot;%1&quot;" Click="InsertPlaceholder_Click" Style="{StaticResource ChipButton}" ToolTip="{x:Static r:Strings.Cmd_InsertFirstTip}">
                                                    <TextBlock><Run Text="&quot;%1&quot;" FontFamily="{StaticResource MonoFont}" /><Run Text="  " /><Run Text="{x:Static r:Strings.Cmd_InsertFirst}" /></TextBlock>
                                                </Button>
                                                <Button Tag="%*" Click="InsertPlaceholder_Click" Style="{StaticResource ChipButton}" ToolTip="{x:Static r:Strings.Cmd_InsertAllTip}">
                                                    <TextBlock><Run Text="%*" FontFamily="{StaticResource MonoFont}" /><Run Text="  " /><Run Text="{x:Static r:Strings.Cmd_InsertAll}" /></TextBlock>
                                                </Button>
                                                <Button Tag="&quot;%d&quot;" Click="InsertPlaceholder_Click" Style="{StaticResource ChipButton}" ToolTip="{x:Static r:Strings.Cmd_InsertDirTip}">
                                                    <TextBlock><Run Text="&quot;%d&quot;" FontFamily="{StaticResource MonoFont}" /><Run Text="  " /><Run Text="{x:Static r:Strings.Cmd_InsertDir}" /></TextBlock>
                                                </Button>
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:Strings.Cmd_ArgumentsHint}" />
                                        </StackPanel>

                                        <Label Grid.Row="4" Content="{x:Static r:Strings.Cmd_WorkingDir}" Target="{Binding ElementName=WorkDirBox}" Style="{StaticResource FieldLabelBox}" />
                                        <TextBox x:Name="WorkDirBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                                 Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                 Margin="0,4" ToolTip="{x:Static r:Strings.Cmd_WorkingDirTip}" FontFamily="{StaticResource MonoFont}" />

                                        <Label Grid.Row="5" Content="{x:Static r:Strings.Cmd_Window}" Target="{Binding ElementName=WindowBox}" Style="{StaticResource FieldLabelBox}" />
                                        <ComboBox x:Name="WindowBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" MinWidth="180" Margin="0,4"
                                                  ItemsSource="{Binding DataContext.WindowChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Window}" />
                                    </Grid>
                                    <CheckBox Content="{x:Static r:Strings.Cmd_LaunchEach}" IsChecked="{Binding LaunchEach}" Margin="0,8,0,4" />
                                    <CheckBox Content="{x:Static r:Strings.Cmd_RunAsAdmin}" IsChecked="{Binding RunAsAdmin}" Margin="0,0,0,4" />
                                </StackPanel>
                            </Border>

                            <!-- Preview -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Padding="10,4" ToolTip="{x:Static r:Strings.Cmd_TryRunTip}"
                                                Command="{Binding DataContext.TryRunCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" />
                                                <TextBlock Text="{x:Static r:Strings.Cmd_TryRun}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center" Text="{x:Static r:Strings.Cmd_SectionPreview}" />
                                    </DockPanel>
                                    <Border Padding="10" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBox Text="{Binding Preview, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Icon -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static r:Strings.Cmd_SectionIcon}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Left">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" />
                                        </Border>
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="200" Margin="0,2" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{x:Static r:Strings.Cmd_SectionIcon}"
                                                  ItemsSource="{Binding DataContext.IconChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding IconSource}" />
                                        <Button Grid.Column="2" Content="{x:Static r:Strings.Cmd_PickIcon}" Margin="6,2,0,2" VerticalAlignment="Center"
                                                Command="{Binding DataContext.BrowseIconCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" IsEnabled="{Binding IconEnabled}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged, Delay=400}" FontFamily="{StaticResource MonoFont}"
                                                     ToolTip="{x:Static r:Strings.Cmd_IconPathTip}" AutomationProperties.Name="{x:Static r:Strings.Cmd_IconPathTip}" />
                                            <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Cmd_IconIndex}" VerticalAlignment="Center" Margin="10,0,6,0" />
                                            <TextBox Grid.Column="2" Text="{Binding IconIndex, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="56"
                                                     AutomationProperties.Name="{x:Static r:Strings.Cmd_IconIndex}" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding OriginSummary}" Style="{StaticResource Hint}" Margin="4,0,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================== Groups ============================== -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="{x:Static r:Strings.Tab_Groups}" /><Run Text=" (" Foreground="Gray" /><Run Text="{Binding Groups.Count, Mode=OneWay}" Foreground="Gray" /><Run Text=")" Foreground="Gray" />
                    </TextBlock>
                </TabItem.Header>
                <DockPanel Margin="0,8,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button Command="{Binding AddGroupCommand}" Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" />
                                <TextBlock Text="{x:Static r:Strings.Grp_Add}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding BrowseGroupIconCommand}" Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xEB9F;" />
                                <TextBlock Text="{x:Static r:Strings.Grp_SetIcon}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearGroupIconCommand}" Style="{StaticResource ToolButton}" Content="{x:Static r:Strings.Grp_ClearIcon}" />
                        <Rectangle Style="{StaticResource ToolSeparator}" />
                        <Button Command="{Binding DeleteGroupCommand}" Style="{StaticResource ToolButton}" ToolTip="{x:Static r:Strings.Grp_DeleteTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                                <TextBlock Text="{x:Static r:Strings.Grp_Delete}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{x:Static r:Strings.Grp_Hint}" />
                    <Grid>
                        <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" AutoGenerateColumns="False"
                                  PreviewKeyDown="GroupGrid_PreviewKeyDown"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Icon}" Width="16" Height="16" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static r:Strings.Grp_ColTitle}" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="*" />
                                <DataGridTextColumn Header="{x:Static r:Strings.Grp_ColIcon}" Binding="{Binding IconSummary, Mode=OneWay}" IsReadOnly="True" Width="180" />
                                <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" IsReadOnly="True" Width="180" />
                                <DataGridTextColumn Header="{x:Static r:Strings.Grp_ColCount}" Binding="{Binding CommandCount, Mode=OneWay}" IsReadOnly="True" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Groups.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" FontSize="28" Opacity="0.4" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="{x:Static r:Strings.Grp_Empty}" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============================== Settings ============================== -->
            <TabItem Header="{x:Static r:Strings.Tab_Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,8,12" MaxWidth="780" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static r:Strings.Set_Menu}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{x:Static r:Strings.Set_MenuTitle}" Target="{Binding ElementName=MenuTitleBox}" Style="{StaticResource FieldLabelBox}" />
                                    <TextBox x:Name="MenuTitleBox" Grid.Column="1" Text="{Binding MenuTitle, UpdateSourceTrigger=PropertyChanged, Delay=300}" MinWidth="280" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:Strings.Set_MenuTitleHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static r:Strings.Set_Language}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Content="{x:Static r:Strings.Set_LanguageLabel}" Target="{Binding ElementName=LanguageBox}" Style="{StaticResource FieldLabelBox}" />
                                    <ComboBox x:Name="LanguageBox" Grid.Column="1" HorizontalAlignment="Left" MinWidth="240"
                                              ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding Language}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:Strings.Set_LanguageHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static r:Strings.Set_Package}" />
                                <TextBlock Text="{Binding PackageMessage}" TextWrapping="Wrap" />
                                <Button Content="{Binding PackageAction}" Command="{Binding RegisterPackageCommand}"
                                        Visibility="{Binding HasPackageAction, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" />
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:Strings.Set_PackageHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static r:Strings.Set_Explorer}" />
                                <CheckBox Content="{x:Static r:Strings.Set_RestartOnSave}" IsChecked="{Binding RestartExplorerOnSave}" />
                                <Button Command="{Binding RestartExplorerCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                                        <TextBlock Text="{x:Static r:Strings.Main_RestartExplorerNow}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:Strings.Set_ExplorerHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static r:Strings.Set_Diagnostics}" />
                                <CheckBox Content="{x:Static r:Strings.Set_Logging}" IsChecked="{Binding Logging}" />
                                <Button Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" />
                                        <TextBlock Text="{x:Static r:Strings.Set_OpenDataFolder}" />
                                    </StackPanel>
                                </Button>
                                <TextBox Text="{Binding ConfigPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Opacity="0.7" FontSize="12" Margin="0,6,0,0" Padding="0" FontFamily="{StaticResource MonoFont}"
                                         ToolTip="{x:Static r:Strings.Set_ConfigFile}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeader}" Text="{x:Static r:Strings.Set_About}" />
                                <TextBlock>
                                    <Run Text="ContextBridge " FontWeight="SemiBold" /><Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static r:Strings.Set_NoNetwork}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
