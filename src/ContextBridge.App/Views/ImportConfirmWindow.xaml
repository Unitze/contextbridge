<Window x:Class="ContextBridge.App.Views.ImportConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:ContextBridge.App.Resources"
        Title="{x:Static r:Strings.Import_WindowTitle}" Width="920" Height="640" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="{x:Static r:Strings.Common_SelectAll}" Click="SelectAll_Click" Margin="0,0,6,0" />
                    <Button Content="{x:Static r:Strings.Common_SelectNone}" Click="SelectNone_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="Confirmed" Content="{x:Static r:Strings.Import_Confirmed}" VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="Confirmed_Changed" Unchecked="Confirmed_Changed" />
                    <Button x:Name="OkButton" Content="{x:Static r:Strings.Import_Ok}" IsEnabled="False" Click="Ok_Click" Style="{StaticResource DialogAccentButton}" />
                    <Button Content="{x:Static r:Strings.Import_Abort}" IsCancel="True" IsDefault="True" Style="{StaticResource DialogButton}" />
                </StackPanel>
            </DockPanel>
        </Border>
    <DockPanel Margin="24,20,24,12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="Header" Style="{StaticResource DialogTitle}" />
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,4,0,0" />
            <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" Padding="12,10" Margin="0,10,0,0" CornerRadius="4">
                <DockPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                    <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Import_Warning}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Border x:Name="BlockingText" DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="12,10" CornerRadius="4" Visibility="Collapsed"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
            <DockPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xEA39;" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock TextWrapping="Wrap" Text="{x:Static r:Strings.Import_Blocking}" />
            </DockPanel>
        </Border>

        <ItemsControl x:Name="Items">
            <ItemsControl.Template>
                <ControlTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Include}" VerticalAlignment="Top" Margin="0,2,10,0"
                                      Checked="Include_Changed" Unchecked="Include_Changed" />
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding DisplayTitle, Mode=OneWay}" /><Run Text="  (" /><Run Text="{Binding Command.Id, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Static r:Strings.Import_Program}" Opacity="0.7" Margin="0,0,12,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Command.Action.Program, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                             FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Background="Transparent" />
                                    <TextBlock Grid.Row="1" Text="{x:Static r:Strings.Import_ResolvedPath}" Opacity="0.7" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ResolvedProgram, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                             FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Background="Transparent" />
                                    <TextBlock Grid.Row="2" Text="{x:Static r:Strings.Import_Arguments}" Opacity="0.7" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Command.Action.Arguments, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                             FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Background="Transparent" />
                                    <TextBlock Grid.Row="3" Text="{x:Static r:Strings.Import_WorkingDir}" Opacity="0.7" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WorkingDirectoryDisplay, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                             FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Background="Transparent" />
                                    <TextBlock Grid.Row="4" Text="{x:Static r:Strings.Import_Icon}" Opacity="0.7" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding IconDisplay, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                             FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Background="Transparent" />
                                    <TextBlock Grid.Row="5" Text="{x:Static r:Strings.Import_Targets}" Opacity="0.7" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TargetSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Findings}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Message, StringFormat=⚠ {0}}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Blocking">
                                                                <Setter Property="Text" Value="{Binding Message, StringFormat=⛔ {0}}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
    </DockPanel>
</Window>
