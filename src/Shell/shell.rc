#include <winver.h>
#include "version.h"

101 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CB_VERSION_COMMA
 PRODUCTVERSION CB_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ContextBridge contributors"
            VALUE "FileDescription", "ContextBridge Explorer command handler"
            VALUE "FileVersion", CB_VERSION_STR
            VALUE "InternalName", "ContextBridge.Shell.dll"
            VALUE "OriginalFilename", "ContextBridge.Shell.dll"
            VALUE "ProductName", "ContextBridge"
            VALUE "ProductVersion", CB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
